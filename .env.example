# Telegram Scraper Credentials
TG_API_ID="1234567"
TG_API_HASH="your_telegram_api_hash"
TG_PHONE_NUMBER="+8801XXXXXXXXX"
TG_TARGET_CHAT="@target_buyer_group"
TG_MESSAGE_LIMIT="50"

# 20-Tier Fallback LLM Architecture Configuration
# The system automatically cascades through up to 20 endpoints if any provider is rate-limited or fails.

# 1. Groq High-Speed Cloud (Slots 1-5)
GROQ_API_KEY="gsk_..."
GROQ_MODEL="qwen/qwen3.8-27b"
GROQ_API_KEY_2="gsk_..."  # Optional secondary key for automatic rotation (Slot 6)

# 2. OpenRouter Multi-Model Aggregator (Slots 7-11, 19)
OPENROUTER_API_KEY="sk-or-v1-..."

# 3. Google Gemini Official API (Slots 12-14)
GEMINI_API_KEY="AIzaSy..."

# 4. DeepSeek Official API (Slot 15)
DEEPSEEK_API_KEY="sk-..."

# 5. Cerebras Cloud Hardware Inference (Slot 16)
CEREBRAS_API_KEY="csk-..."

# 6. SambaNova Cloud Inference (Slot 17)
SAMBANOVA_API_KEY="..."

# 7. Together AI Cloud (Slot 18)
TOGETHER_API_KEY="..."

# 8. Mistral AI Official (Slot 19)
MISTRAL_API_KEY="..."

# 9. OpenCode / Local Ollama Offline Server (Slot 20)
OPENCODE_API_URL="http://localhost:11434/v1/chat/completions"
OPENCODE_API_KEY=""
OPENCODE_MODEL="qwen2.5:7b"

